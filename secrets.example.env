# Placeholder values for every secret and variable this repo's workflows read.
# Copy to a file git ignores, fill in real values, then push with the gh
# snippet at the bottom. NEVER commit the filled-in copy.
#
#   cp secrets.example.env .secrets.env   # .secrets.env is gitignored
#
# Which workflow reads what is documented in README.md.

# ── Hostinger ────────────────────────────────────────────────────────────────
# hPanel → Profile → API
HOSTINGER_API_KEY=hpanel-api-key-goes-here
# Repository VARIABLE, not a secret. From the hPanel URL:
# https://hpanel.hostinger.com/vps/123456/overview
HOSTINGER_VM_ID=123456

# ── VPS SSH access ───────────────────────────────────────────────────────────
VPS_SSH_HOST=203.0.113.10
VPS_SSH_USERNAME=root
# BASE64-ENCODED private key — the workflows pipe it through `base64 -d`.
#   base64 -w0 < ~/.ssh/id_ed25519
VPS_SSH_KEY=LS0tLS1CRUdJTiBPUEVOU1NIIFBSSVZBVEUgS0VZLS0tLS0...replace-me

# ── GitHub App backing the self-hosted runner ────────────────────────────────
# Settings → Developer settings → GitHub Apps. Needs actions:read, metadata:read.
GH_APP_ID=123456
GH_APP_INSTALLATION_ID=12345678
# BASE64-ENCODED PEM:
#   base64 -w0 < your-app.2026-01-01.private-key.pem
GH_APP_PRIVATE_KEY=LS0tLS1CRUdJTiBSU0EgUFJJVkFURSBLRVktLS0tLQ...replace-me

# ── Vault ────────────────────────────────────────────────────────────────────
# First `Vault Config` apply only. Delete this secret once AppRole auth works.
VAULT_BOOTSTRAP_TOKEN=hvs.replace-me-bootstrap-token
# Steady state. See VAULT-WORKFLOW-RUNBOOK.md for how to mint these.
#   vault read auth/approle/role/terraform-ci/role-id
#   vault write -f auth/approle/role/terraform-ci/secret-id
VAULT_CI_ROLE_ID=00000000-0000-0000-0000-000000000000
VAULT_CI_SECRET_ID=00000000-0000-0000-0000-000000000000
# Repository VARIABLE. Optional — defaults to "approle" when unset.
VAULT_APPROLE_PATH=approle

# ─────────────────────────────────────────────────────────────────────────────
# Push everything with the gh CLI, from the directory holding your filled-in
# copy. Secrets and variables are deliberately split.
#
#   set -a; . ./.secrets.env; set +a
#
#   for s in HOSTINGER_API_KEY VPS_SSH_HOST VPS_SSH_USERNAME VPS_SSH_KEY \
#            GH_APP_ID GH_APP_INSTALLATION_ID GH_APP_PRIVATE_KEY \
#            VAULT_BOOTSTRAP_TOKEN VAULT_CI_ROLE_ID VAULT_CI_SECRET_ID; do
#     [ -n "${!s}" ] && gh secret set "$s" --body "${!s}"
#   done
#
#   for v in HOSTINGER_VM_ID VAULT_APPROLE_PATH; do
#     [ -n "${!v}" ] && gh variable set "$v" --body "${!v}"
#   done
