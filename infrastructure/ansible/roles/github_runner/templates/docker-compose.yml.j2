services:
  runner:
    image: {{ github_runner_image }}
    restart: unless-stopped
    environment:
      RUNNER_SCOPE: repo
      REPO_URL: "https://github.com/{{ item.repo }}"
      APP_ID: "{{ github_app_id }}"
      APP_LOGIN: "{{ item.repo.split('/')[0] }}"
      APP_PRIVATE_KEY: |
{{ github_app_private_key | b64decode | indent(8, first=True) }}
      RUNNER_NAME: "{{ item.name }}"
      LABELS: "{{ item.labels | default('linux') }}"
      RUNNER_WORKDIR: /tmp/runner/work
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - runner_work:/tmp/runner
    # Needed so jobs can start kind/k3d clusters. ADR-0013 covers what this
    # trades away — a job on this runner is effectively root on the host.
    privileged: true

volumes:
  runner_work:
    name: runner-{{ item.name }}-work
